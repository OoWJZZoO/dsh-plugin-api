{
  "name": "@deepseek-ai/dsh-plugin-api-main",
  "description": "DeepSeek Harness community plugin API facade: stabilized semantic hooks over official extension points. Version model <A>-<B>.<C>.<D> with dsh.api carrying <B>.<C>; the 0.1 API baseline consolidates the domain-first public contract surface.",
  "version": "0.1.0-rc.6-0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./typert": "./lib/typert.js",
    "./profile-fold": "./lib/profile-fold.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "api": "0.1",
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "immediately": true
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "DBUS_SESSION_BUS_ADDRESS=${DBUS_SESSION_BUS_ADDRESS:-unix:path=/run/user/1000/bus} systemd-run --user --scope -p MemoryMax=4G npm run test:raw",
    "test:raw": "node --test \"test/**/*.mjs\" \"packages/*/test/*.mjs\"",
    "build:client": "node scripts/build-client-bundle.mjs",
    "build:client:check": "node scripts/build-client-bundle.mjs --check"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "dsh-plugin-api-main",
    "llm-admission"
  ],
  "license": "MIT",
  "dependencies": {
    "js-yaml": "^4.3.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-scope": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session-reference": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-user-approval": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-schedule": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-subagent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-subagent-in-process-driver": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-agent-loop": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-registry": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-connection": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-api-remotes": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.6"
  }
}
